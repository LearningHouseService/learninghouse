# Include the README
include *.md

# Include the license file
include LICENSE

# Include information about third party licensors
include THIRD-PARTY-NOTICES

recursive-include learninghouse *.py
recursive-include learninghouse/static *

# The UI is built in a separate job and copied in before the package is built,
# so it is not tracked by git and has to be named explicitly here.
recursive-include learninghouse/ui *
